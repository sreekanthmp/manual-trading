# The settings Prism reads. Copy what you need into your environment, or into a git-ignored `.env` file in the folder Prism is started from
# (real environment variables win over the file). Do NOT put real values in a tracked file.
# PowerShell, current user, persistent:
#   [Environment]::SetEnvironmentVariable("ANGEL_API_KEY", "<value>", "User")

# ── Angel One credentials (required) ──────────────────────────────────────────
# ANGEL_PASSWORD is the account PIN; ANGEL_TOTP is the TOTP *secret* (base32), not a 6-digit code.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP=

# ── PostgreSQL: the existing prism database (history, read-only) ──────────────
# Prism only reads it (a read-only session, SELECT only): use a dedicated SELECT-only role, never a superuser.
# Without PG_PASSWORD the live pipeline still runs and the dashboard says why the analysis is unavailable.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DBNAME=prism

# ── The decision journal (optional) ───────────────────────────────────────────
# Where decisions-<date>.jsonl and the one-copy lock live. Default: the `logs` folder beside the app (a relative path here
# means relative to the folder Prism is started from).
# JOURNAL_DIR=C:\prism-logs
# Every record but the once-per-candle heartbeat is synced to disk; 0 turns that off.
# JOURNAL_FSYNC=1

# ── Who may reach the API (optional) ──────────────────────────────────────────
# Prism's API has no login, so a launch whose --host is not this computer (127.0.0.1, localhost, ::1) is refused before anything is started.
# Set this to 1 only to share Prism on a network you trust.
# PRISM_ALLOW_REMOTE=1

# ── Strategy and option thresholds (optional) ─────────────────────────────────
# Every field of app.strategy.Params is STRATEGY_<FIELD NAME IN CAPITALS> (86 of them) and every field of
# app.options.OptionParams is OPTIONS_<FIELD NAME> (14); anything not set keeps its default. The defaults are the tested ones.
# STRATEGY_LAST_ENTRY=14:45
# STRATEGY_MIDDAY_START=12:00
# OPTIONS_STRIKES_EACH_SIDE=3
# OPTIONS_WARN_SPREAD_PCT=1.0
